  "narrative": {
    "northStar": "The Check Print",
    "overview": "La web es el pliego de pruebas que un diseñador revisa antes de imprimir. Lo que hace Open-DTF (convertir tono continuo en puntos, tinta por tinta) es el propio tema de la hoja, así que la página muestra sus separaciones en lugar de describirlas: marcas de corte, diana de registro, barra de color y una línea de pie con datos reales.",
    "keyCharacteristics": [
      "Papel blanco frío (nunca crema), tinta K y tres tintas de proceso como campos de página.",
      "Mobiliario de imprenta dibujado en CSS/SVG.",
      "Rectilíneo: bordes de 1,5 px en tinta K, radio de 2 px, sin sombras.",
      "Un momento firmado: la titular entra desregistrada y encaja."
    ],
    "rules": [
      {
        "name": "The Ink Field Rule",
        "body": "Cada tinta de proceso ocupa una sección entera o no aparece.",
        "section": "colors"
      },
      {
        "name": "The Cool Paper Rule",
        "body": "El papel es blanco frío (#f4f5f3). Un papel cálido o crema es una deriva.",
        "section": "colors"
      },
      {
        "name": "The Weight Contrast Rule",
        "body": "El énfasis tipográfico se hace con peso (800 frente a 300) dentro de la misma familia de display.",
        "section": "typography"
      },
      {
        "name": "The Wordmark Only Rule",
        "body": "Instrument Serif Italic vive únicamente en «Open» del logotipo.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Ninguna superficie lleva sombra; se separa con borde K o cambio de campo de tinta.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do dar a cada tinta de proceso una región entera de la página.",
      "Do usar bordes de 1,5 px en K en lugar de sombras.",
      "Do mantener el negro K en texto sobre cian, magenta y amarillo.",
      "Do usar la barra de color y las marcas de corte como estructura.",
      "Do respetar prefers-reduced-motion."
    ],
    "donts": [
      "Don't usar papel crema ni cálido.",
      "Don't usar sombras, degradados en texto ni acentos laterales de color.",
      "Don't poner etiquetas o numeraciones encima de un titular.",
      "Don't usar la serif cursiva fuera del logotipo."
    ]
  }
